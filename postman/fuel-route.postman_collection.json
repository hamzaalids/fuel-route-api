{
  "info": {
    "name": "Fuel Route API",
    "_postman_id": "6f1c2c3e-5b1a-4d9e-9f1e-0a1b2c3d4e5f",
    "description": "Route between two US locations with cost-optimal fuel stops (500-mile range, 10 MPG).\n\nRun the requests top to bottom. Each request has tests that check the API contract; watch `meta.external_api_calls`, `meta.cache_hit` and `meta.timings_ms` in the response body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('vehicle config', () => {",
              "  const v = pm.response.json().vehicle;",
              "  pm.expect(v.max_range_miles).to.eql(500);",
              "  pm.expect(v.mpg).to.eql(10);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Happy path: New York -> Chicago",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Chicago, IL\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('exactly one external API call (OSRM)', () => pm.expect(body.meta.external_api_calls).to.eql(1));",
              "pm.test('total gallons == distance / 10', () => pm.expect(Math.abs(body.summary.total_gallons - body.route.distance_miles / 10)).to.be.below(0.002));",
              "pm.test('stop costs + origin fill == total', () => {",
              "  const cents = x => Math.round(x * 100);",
              "  const sum = body.fuel_stops.reduce((a, s) => a + cents(s.cost), 0) + cents(body.summary.origin_fill.cost);",
              "  pm.expect(sum).to.eql(cents(body.summary.total_fuel_cost));",
              "});",
              "pm.test('no leg longer than 500 miles', () => {",
              "  const pts = [0, ...body.fuel_stops.map(s => s.miles_from_start), body.route.distance_miles];",
              "  for (let i = 1; i < pts.length; i++) pm.expect(pts[i] - pts[i - 1]).to.be.at.most(500);",
              "});",
              "pm.collectionVariables.set('mapUrl', body.map.url);",
              "console.log('Map page: ' + pm.collectionVariables.get('baseUrl') + body.map.url);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Cache-hit demo: repeat New York -> Chicago",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"new york, ny\",\n  \"finish\": \"Chicago, Illinois\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('served from cache', () => pm.expect(body.meta.cache_hit).to.eql(true));",
              "pm.test('zero external API calls', () => pm.expect(body.meta.external_api_calls).to.eql(0));",
              "pm.test('fast', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Map page for the last plan",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}{{mapUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 html', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'); });",
              "console.log('Open in a browser: ' + pm.request.url.toString());"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Long trip: Miami -> Seattle",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Miami, FL\",\n  \"finish\": \"Seattle, WA\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('coast to coast > 3000 miles with many stops', () => {",
              "  pm.expect(body.route.distance_miles).to.be.above(3000);",
              "  pm.expect(body.fuel_stops.length).to.be.at.least(7);",
              "});",
              "pm.test('one external call', () => pm.expect(body.meta.external_api_calls).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Short trip (< 500 mi): Denver -> Colorado Springs",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Denver, CO\",\n  \"finish\": \"Colorado Springs, CO\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('no intermediate stop needed; fuel bought at origin', () => {",
              "  pm.expect(body.summary.number_of_stops).to.eql(0);",
              "  pm.expect(body.summary.origin_fill.gallons).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Coordinates input: LA -> Dallas",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"34.0522,-118.2437\",\n  \"finish\": \"Dallas, TX\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('lat,lon skipped geocoding', () => pm.expect(body.meta.geocode_sources.start).to.eql('coords'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Error: missing field (400 invalid_request)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 invalid_request', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('invalid_request');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Error: unknown city (404 location_not_found)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Qzxvbnm Imaginaryville, ZZ\",\n  \"finish\": \"Chicago, IL\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 location_not_found', () => {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().error.code).to.eql('location_not_found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Error: same start and finish (400 invalid_request)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"chicago,  il\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 invalid_request', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('invalid_request');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Error: outside USA (400 outside_usa)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"61.2181,-149.9003\",\n  \"finish\": \"Chicago, IL\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 outside_usa', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('outside_usa');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
