# Copy to .env and adjust. All values shown are the defaults used when unset.

# --- Django -----------------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-in-production
DEBUG=true
# Comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1

# --- External services ------------------------------------------------------
# Public OSRM demo server (fine for demos; self-host for production).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10
# Nominatim is used ONLY as a fallback when a start/finish string is not
# "City, ST" or "lat,lon". Its usage policy requires an identifying User-Agent;
# placeholder domains such as example.com are rejected with HTTP 403, so put
# your real project URL or contact here.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-api/1.0 (local development; set NOMINATIM_USER_AGENT)

# --- Vehicle / optimizer ----------------------------------------------------
MAX_RANGE_MILES=500
MPG=10
# Stations located at city-centroid accuracy, so the corridor is generous.
CORRIDOR_MILES=10

# --- Caching ----------------------------------------------------------------
# Full route responses are cached for this many seconds.
ROUTE_CACHE_TTL=86400
# Django cache backend class. Default is in-process memory. To use Redis with
# Django's built-in backend: django.core.cache.backends.redis.RedisCache
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# Only needed for non-locmem backends, e.g. redis://127.0.0.1:6379/1
CACHE_LOCATION=

# --- Data pipeline ----------------------------------------------------------
# How duplicate rows for the same OPIS Truckstop ID are collapsed: min | max | first
STATION_PRICE_POLICY=min
